{
  "name": "@zivue/zuuid",
  "version": "0.1.0",
  "description": "TypeScript helpers for fetching, searching, and transforming Zuuid datasets.",
  "type": "module",
  "license": "MIT",
  "author": "Zivue",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/zivue/zuuid.git"
  },
  "bugs": {
    "url": "https://github.com/zivue/zuuid/issues"
  },
  "homepage": "https://github.com/zivue/zuuid#readme",
  "keywords": [
    "zuuid",
    "uuid-v5",
    "metadata",
    "dataset",
    "tmdb"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./providers/tmdb": {
      "types": "./dist/providers/tmdb/index.d.ts",
      "import": "./dist/providers/tmdb/index.js"
    },
    "./providers/tmdb/movie": {
      "types": "./dist/providers/tmdb/movie.d.ts",
      "import": "./dist/providers/tmdb/movie.js"
    },
    "./providers/tmdb/tv": {
      "types": "./dist/providers/tmdb/tv.d.ts",
      "import": "./dist/providers/tmdb/tv.js"
    },
    "./providers/tmdb/person": {
      "types": "./dist/providers/tmdb/person.d.ts",
      "import": "./dist/providers/tmdb/person.js"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "example:tmdb": "npm run build && node examples/tmdb-movie.mjs",
    "prepublishOnly": "npm run clean && npm run test",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
